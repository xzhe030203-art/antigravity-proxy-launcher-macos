# 将本文件复制到 ~/.config/antigravity-proxy-launcher/config.env 即可生效
# Copy to ~/.config/antigravity-proxy-launcher/config.env to customize

# 本地 HTTP/HTTPS 代理主机与端口（如企业内网代理、抓包工具或本地代理客户端监听端口）
PROXY_HOST=127.0.0.1
PROXY_PORT=7890

# 不走代理的地址列表（强烈建议保留 localhost,127.0.0.1,::1 以避免影响本地 Sidecar/MCP 插件）
NO_PROXY=localhost,127.0.0.1,::1

# Antigravity.app 安装路径
APP_PATH=/Applications/Antigravity.app

# 是否开启远程调试端口（1=开启 --remote-debugging-port=0 并自动清理陈旧 DevToolsActivePort；0=关闭）
ENABLE_REMOTE_DEBUG=1
